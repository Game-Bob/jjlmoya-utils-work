---
import { Icon } from 'astro-icon/components';
import type { KnownLocale } from '../../types';
import type { AutonomosCalculatorUI } from './ui';
import {
  SUPPORTED_CURRENCIES,
  getCurrencyLabel,
  getCurrencySymbol,
  getDefaultCurrency,
} from '../../currency';

interface Props {
  locale?: KnownLocale;
  ui?: Record<string, unknown>;
}

const { locale = 'en', ui } = Astro.props;
const t = (ui ?? {}) as AutonomosCalculatorUI;
const defaultCurrency = getDefaultCurrency(locale);
---

<div class="ac-container">
  <div class="ac-card">
    <div class="ac-input-grid">
      <div class="ac-input-group">
        <label for="autonomos-currency">{getCurrencyLabel(locale)}</label>
        <div class="ac-input-wrapper">
          <select id="autonomos-currency">
            {SUPPORTED_CURRENCIES.map((item) => (
              <option value={item.code} selected={item.code === defaultCurrency}>
                {item.code} ({item.symbol})
              </option>
            ))}
          </select>
        </div>
      </div>
      <div class="ac-input-group">
        <label for="monthly-income">{t.labelIncome}</label>
        <div class="ac-input-wrapper">
          <input
            type="number"
            id="monthly-income"
            placeholder="3000"
            min="0"
            value="3000"
          />
          <span class="ac-input-unit" data-currency-symbol>{getCurrencySymbol(defaultCurrency)}</span>
        </div>
      </div>

      <div class="ac-input-group">
        <label for="monthly-expenses">{t.labelExpenses}</label>
        <div class="ac-input-wrapper">
          <input
            type="number"
            id="monthly-expenses"
            placeholder="500"
            min="0"
            value="500"
          />
          <span class="ac-input-unit" data-currency-symbol>{getCurrencySymbol(defaultCurrency)}</span>
        </div>
      </div>

      <div class="ac-input-group">
        <label for="autonomo-type">{t.labelType}</label>
        <div class="ac-input-wrapper">
          <select id="autonomo-type">
            <option value="standard">{t.optStandard}</option>
            <option value="societario">{t.optSocietario}</option>
          </select>
        </div>
      </div>

      <div class="ac-input-group">
        <label for="flat-rate">{t.labelFlatRate}</label>
        <div class="ac-input-wrapper">
          <select id="flat-rate">
            <option value="no">{t.optNoFlatRate}</option>
            <option value="yes">{t.optFlatRate}</option>
          </select>
        </div>
      </div>
    </div>

    <div class="ac-bracket-info" id="bracket-info">
      <div class="ac-bracket-title">
        <span>{t.labelBracket}</span>
        <span class="ac-bracket-pill" id="bracket-label">Tramo 3 (Reducido)</span>
      </div>
      <div class="ac-slider-group">
        <input
          type="range"
          id="income-slider"
          min="0"
          max="8000"
          step="50"
          value="3000"
          aria-label={t.labelIncome}
        />
        <p class="ac-net-display-text">
          {t.labelNetDisplay}: <strong id="net-display">0 {getCurrencySymbol(defaultCurrency)}</strong>
        </p>
      </div>
    </div>

    <div class="ac-results-grid">
      <div class="ac-result-card ac-highlight">
        <span class="ac-result-label">{t.labelCuota}</span>
        <span class="ac-result-value ac-primary" id="val-cuota">0,00 {getCurrencySymbol(defaultCurrency)}</span>
        <span class="ac-projection-label">{t.labelProjection}</span>
      </div>
      <div class="ac-result-card">
        <span class="ac-result-label">{t.labelBase}</span>
        <span class="ac-result-value" id="val-base">0,00 {getCurrencySymbol(defaultCurrency)}</span>
      </div>
      <div class="ac-result-card">
        <span class="ac-result-label">{t.labelNetAfter}</span>
        <span class="ac-result-value" id="val-net-after">0,00 {getCurrencySymbol(defaultCurrency)}</span>
      </div>
    </div>

    <div class="ac-info-alert">
      <Icon name="mdi:information-outline" class="ac-info-icon" />
      <p>{t.infoText}</p>
    </div>
  </div>
</div>

<script>
  import { AutonomosCalculator } from './logic';
  import {
    formatCurrency,
    convertCurrencyValue,
    fromInternalCurrency,
    getDefaultCurrency,
    getCurrencySymbol,
    toInternalCurrency,
    type CurrencyCode,
  } from '../../currency';

  const incomeInput = document.getElementById('monthly-income') as HTMLInputElement | null;
  const expenseInput = document.getElementById('monthly-expenses') as HTMLInputElement | null;
  const typeSelect = document.getElementById('autonomo-type') as HTMLSelectElement | null;
  const flatRateSelect = document.getElementById('flat-rate') as HTMLSelectElement | null;
  const incomeSlider = document.getElementById('income-slider') as HTMLInputElement | null;
  const currencySelect = document.getElementById('autonomos-currency') as HTMLSelectElement | null;
  let currentCurrency: CurrencyCode = getDefaultCurrency(document.documentElement.lang);

  const cuotaDisplay = document.getElementById('val-cuota');
  const baseDisplay = document.getElementById('val-base');
  const netAfterDisplay = document.getElementById('val-net-after');
  const netDisplay = document.getElementById('net-display');
  const bracketLabel = document.getElementById('bracket-label');

  function formatMoney(val: number): string {
    return formatCurrency(fromInternalCurrency(val, currentCurrency), currentCurrency, document.documentElement.lang);
  }

  function getNumericValue(el: HTMLInputElement | null): number {
    return parseFloat(el?.value ?? '0') || 0;
  }

  function getSelectValue(el: HTMLSelectElement | null): string {
    return el?.value ?? '';
  }

  function getParams() {
    return {
      income: toInternalCurrency(getNumericValue(incomeInput), currentCurrency),
      expenses: toInternalCurrency(getNumericValue(expenseInput), currentCurrency),
      isSocietario: getSelectValue(typeSelect) === 'societario',
      isFlatRate: getSelectValue(flatRateSelect) === 'yes',
    };
  }

  function updateUI(results: ReturnType<typeof AutonomosCalculator.calculate>) {
    if (netDisplay) netDisplay.textContent = formatMoney(results.rendimientoNeto);
    if (cuotaDisplay) cuotaDisplay.textContent = formatMoney(results.cuota);
    if (baseDisplay) baseDisplay.textContent = formatMoney(results.baseCotizacion);
    if (netAfterDisplay) netAfterDisplay.textContent = formatMoney(results.netAfter);
    if (bracketLabel) bracketLabel.textContent = results.bracketLabel;
  }

  function calculate() {
    if (!incomeInput || !expenseInput || !typeSelect || !flatRateSelect) return;
    const params = getParams();
    if (incomeSlider) {
      incomeSlider.value = Math.min(params.income, 8000).toString();
    }
    updateUI(AutonomosCalculator.calculate(params));
  }

  function handleSlider() {
    if (incomeInput && incomeSlider) {
      incomeInput.value = incomeSlider.value;
      calculate();
    }
  }

  [incomeInput, expenseInput, typeSelect, flatRateSelect].forEach((el) => {
    el?.addEventListener('input', calculate);
  });
  incomeSlider?.addEventListener('input', handleSlider);
  currencySelect?.addEventListener('change', () => {
    const next = currencySelect.value as CurrencyCode;
    if (incomeInput) incomeInput.value = convertCurrencyValue(getNumericValue(incomeInput), currentCurrency, next).toFixed(2);
    if (expenseInput) expenseInput.value = convertCurrencyValue(getNumericValue(expenseInput), currentCurrency, next).toFixed(2);
    if (incomeSlider && incomeInput) incomeSlider.value = Math.min(Number(incomeInput.value) || 0, 8000).toString();
    currentCurrency = next;
    document.querySelectorAll<HTMLElement>('[data-currency-symbol]').forEach((el) => {
      el.textContent = getCurrencySymbol(currentCurrency);
    });
    calculate();
  });

  calculate();
</script>
