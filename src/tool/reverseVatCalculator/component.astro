---
import type { KnownLocale } from '../../types';
import type { ReverseVatCalculatorUI } from './ui';
import {
  SUPPORTED_CURRENCIES,
  getCurrencyLabel,
  getCurrencySymbol,
  getDefaultCurrency,
} from '../../currency';

interface Props {
  locale?: KnownLocale;
  ui?: Record<string, unknown>;
}

const { locale = 'en', ui } = Astro.props;
const t = (ui ?? {}) as ReverseVatCalculatorUI;
const defaultCurrency = getDefaultCurrency(locale);
---

<div class="rv-wrapper">
  <div class="rv-card">
    <div class="rv-bg-icon" aria-hidden="true">
      <svg fill="currentColor" viewBox="0 0 24 24">
        <path d="M3 6h18v12H3V6m2 2v8h14V8H5m4 2h6v4H9v-4z"></path>
      </svg>
    </div>

    <div class="rv-content">
      <div class="rv-field">
        <label for="rv-currency" class="rv-label">{getCurrencyLabel(locale)}</label>
        <select id="rv-currency" class="rv-currency-select">
          {SUPPORTED_CURRENCIES.map((item) => (
            <option value={item.code} selected={item.code === defaultCurrency}>
              {item.code} ({item.symbol})
            </option>
          ))}
        </select>
      </div>
      <div class="rv-field">
        <label for="total-amount" class="rv-label">{t.labelTotal}</label>
        <div class="rv-input-wrapper">
          <span class="rv-currency" data-currency-symbol>{getCurrencySymbol(defaultCurrency)}</span>
          <input
            type="number"
            id="total-amount"
            placeholder="121.00"
            class="rv-input"
          />
        </div>
      </div>

      <div class="rv-field">
        <label class="rv-label">{t.labelVatType}</label>
        <div class="rv-btn-group">
          <button class="rv-btn rv-active" data-val="21">{t.btn21}</button>
          <button class="rv-btn" data-val="10">{t.btn10}</button>
          <button class="rv-btn" data-val="4">{t.btn4}</button>
          <button class="rv-btn" data-val="0">{t.btn0}</button>
        </div>
      </div>

      <div class="rv-results">
        <div class="rv-result-row rv-result-base">
          <span class="rv-result-label">{t.labelBase}</span>
          <span id="base-amount" class="rv-result-value">0.00 {getCurrencySymbol(defaultCurrency)}</span>
        </div>
        <div class="rv-result-row">
          <span class="rv-result-label">
            {t.labelVat} (<span id="vat-rate-display">21</span> %)
          </span>
          <span id="vat-amount" class="rv-result-value rv-vat-value">0.00 {getCurrencySymbol(defaultCurrency)}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { ReverseVatCalculator } from './logic';
  import {
    formatCurrency,
    convertCurrencyValue,
    fromInternalCurrency,
    getDefaultCurrency,
    getCurrencySymbol,
    toInternalCurrency,
    type CurrencyCode,
  } from '../../currency';

  const totalInput = document.getElementById('total-amount') as HTMLInputElement;
  const baseOutput = document.getElementById('base-amount');
  const vatOutput = document.getElementById('vat-amount');
  const vatRateDisplay = document.getElementById('vat-rate-display');
  const vatBtns = document.querySelectorAll('.rv-btn');
  const currencySelect = document.getElementById('rv-currency') as HTMLSelectElement;

  let currentRate = 21;
  let currentCurrency: CurrencyCode = getDefaultCurrency(document.documentElement.lang);

  function formatAmount(val: number): string {
    return formatCurrency(fromInternalCurrency(val, currentCurrency), currentCurrency, document.documentElement.lang).replace(/\u00A0/g, ' ');
  }

  function calculate() {
    const total = toInternalCurrency(parseFloat(totalInput.value) || 0, currentCurrency);
    const { base, vat } = ReverseVatCalculator.calculate(total, currentRate);
    if (baseOutput) baseOutput.textContent = formatAmount(base);
    if (vatOutput) vatOutput.textContent = formatAmount(vat);
  }

  function handleVatBtn(e: Event) {
    const target = e.target as HTMLElement;
    vatBtns.forEach((b) => b.classList.remove('rv-active'));
    target.classList.add('rv-active');
    currentRate = parseFloat(target.getAttribute('data-val') ?? '21');
    if (vatRateDisplay) vatRateDisplay.textContent = currentRate.toString();
    calculate();
  }

  totalInput.addEventListener('input', calculate);
  vatBtns.forEach((btn) => btn.addEventListener('click', handleVatBtn));
  currencySelect?.addEventListener('change', () => {
    const next = currencySelect.value as CurrencyCode;
    totalInput.value = convertCurrencyValue(Number(totalInput.value) || 0, currentCurrency, next).toFixed(2);
    currentCurrency = next;
    document.querySelectorAll<HTMLElement>('[data-currency-symbol]').forEach((el) => {
      el.textContent = getCurrencySymbol(currentCurrency);
    });
    calculate();
  });
</script>
